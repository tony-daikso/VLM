# 資料集（太大，不進 git；資料怎麼重建/怎麼搬看 HANDOFF.md / U-VLM/stage1/REMOTE_SETUP.md）
data/*
# 例外：Merlin 報告前處理的程式碼跟文件要進 git（資料 JSON、PDF、原始資料集仍不進）
!data/CT/
data/CT/*
!data/CT/merlin/
data/CT/merlin/*
!data/CT/merlin/RADAR_report_preprocess.md
!data/CT/merlin/scripts/
!data/CT/merlin/reference_mappings/
!data/CT/merlin/llm_check/
data/CT/merlin/llm_check/**/*.json
# CG 自有資料：只放程式碼（報告與 LLM 輸出都含報告原文，不進 git）
!data/CT/CG/
data/CT/CG/*
!data/CT/CG/radar_preprocess/
data/CT/CG/radar_preprocess/*
!data/CT/CG/radar_preprocess/scripts/
!data/CT/CG/radar_preprocess/claude_check/
data/CT/CG/radar_preprocess/claude_check/*
!data/CT/CG/radar_preprocess/claude_check/compare_claude.py

# Python
__pycache__/
*.pyc
*.pyo

